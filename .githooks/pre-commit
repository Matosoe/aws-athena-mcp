#!/usr/bin/env sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
export PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}"

if command -v python >/dev/null 2>&1; then
	python -m athena_knowledge_mcp.utils.secret_scanner --staged
	exit $?
fi

if command -v py >/dev/null 2>&1; then
	py -3 -m athena_knowledge_mcp.utils.secret_scanner --staged
	exit $?
fi

echo "Python nao encontrado para executar o scanner de segredos." >&2
exit 1