{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build MCP EXE",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"scripts\\build_windows_exe.cmd"
			],
			"isBackground": false
		},
		{
			"label": "Git Status Short (CMD)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"git status --short"
			],
			"isBackground": false
		},
		{
			"label": "Git Branch Current (CMD)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"git branch --show-current"
			],
			"isBackground": false
		},
		{
			"label": "Check Winget Availability",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"winget --version"
			],
			"isBackground": false
		}
	]
}